DATABASE_URL=your_supabase_postgres_url_here

# Chat LLM = Together AI (ML team default)
LLM_BASE_URL=https://api.together.ai/v1
LLM_API_KEY=your_together_api_key_here
DEFAULT_MODEL=openai/gpt-oss-20b

# Embeddings disabled on cloud (search uses full-text fallback)
EMBED_ENABLED=false
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text

# Auto-normalize pipeline
CHECK_INTERVAL=15
NORMALIZE_CONCURRENCY=8
NORMALIZE_BATCH_SIZE=30
NORMALIZE_PER_USER_BATCH=4
NORMALIZE_FAIR_SCHEDULE=true
NORMALIZE_MAX_ROUNDS=10
NORMALIZE_PREFILTER=true
NORMALIZE_CLAIM_STALE_SEC=180
LLM_MAX_TOKENS=900
LLM_MAX_RETRIES=6
NORMALIZE_MIN_MESSAGE_ID=0

# Node backend (Watsapp_Web_backend-main/.env)
# JWT_SECRET=your_jwt_secret
# PYTHON_AI_URL=http://localhost:8000
# PORT=5000

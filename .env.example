DATABASE_URL=your_supabase_postgres_url_here

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
DEFAULT_MODEL=openai/gpt-oss-20b

EMBED_ENABLED=false
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text

CHECK_INTERVAL=15
NORMALIZE_CONCURRENCY=1
NORMALIZE_BATCH_SIZE=5
NORMALIZE_PER_USER_BATCH=8
NORMALIZE_FAIR_SCHEDULE=true
NORMALIZE_MAX_ROUNDS=10
NORMALIZE_PREFILTER=true
NORMALIZE_CLAIM_STALE_SEC=180
LLM_MAX_TOKENS=900
LLM_MAX_RETRIES=6
NORMALIZE_MIN_MESSAGE_ID=0

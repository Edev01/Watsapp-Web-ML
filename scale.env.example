# Production scale mode (thousands of users) — copy to .env on EC2
#
# 1. Get free API key: https://console.groq.com/keys
# 2. Replace LLM_API_KEY below
# 3. sudo systemctl restart normalize-pipeline

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_YOUR_KEY_HERE
DEFAULT_MODEL=openai/gpt-oss-20b

# Throughput (free Groq tier ~8000 TPM — use concurrency 2; paid tier can use 12)
NORMALIZE_CONCURRENCY=2
NORMALIZE_BATCH_SIZE=80
NORMALIZE_PER_USER_BATCH=8
NORMALIZE_FAIR_SCHEDULE=true
NORMALIZE_MAX_ROUNDS=10
CHECK_INTERVAL=15

# Skip non-property chat without LLM; disable slow local embeddings
NORMALIZE_PREFILTER=true
EMBED_ENABLED=false
LLM_MAX_TOKENS=600

# Only new messages after cutoff (optional)
# NORMALIZE_MIN_MESSAGE_ID=45336

DATABASE_URL=your_supabase_url_here

            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parse the JSON response",
                  "const response = pm.response.json();",
                  "",
                  "// Check if login was successful (status 200) and contains a token",
                  "if (pm.response.code === 200 && !response.error && response.data && response.data.token) {",
                  "    // Save the token as an environment variable",
                  "    pm.environment.set(\"scrapper_token\", response.data.token);",
                  "    console.log(\"Success: Token stored in 'scrapper_token' environment variable.\");",
                  "} else {",
                  "    console.log(\"Failed to extract token from login response.\");",
                  "}",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
